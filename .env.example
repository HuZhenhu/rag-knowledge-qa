# LLM提供商: deepseek / openai / anthropic
LLM_PROVIDER=deepseek

# OpenAI兼容API（DeepSeek/通义千问/Moonshot/Ollama等）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Embedding配置
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# 切片配置
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# 检索配置
RETRIEVAL_TOP_K=10

# LLM配置
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Agentic RAG 配置
# 引擎切换：langchain / original / agentic
# RAG_ENGINE=agentic
# 联网搜索开关：true 启用 / false 关闭（关闭时 Web-Agent 自动跳过）
AGENT_WEB_SEARCH=false
# 联网搜索服务商：bocha / tavily
AGENT_WEB_SEARCH_PROVIDER=tavily
AGENT_WEB_SEARCH_API_KEY=your_tavily_api_key_here

# HuggingFace国内镜像（中国网络用）
# HF_ENDPOINT=https://hf-mirror.com
